# EvoResearch Environment Configuration Template
# Duplicate this file to .env or .env.local and populate with your credentials.
# NEVER commit real credentials or service-role keys to source control.

# Supabase Configuration
# Project URL from Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Anon / Public Key (Safe for client-side reads)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
# Service Role Key (SERVER-SIDE ONLY - Never expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Next.js Client-Side Mirrors (if frontend queries Supabase directly)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# EvoResearch Backend Service Configuration
BACKEND_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./backend/evoresearch.db

# Materials Science ML Pipeline Execution Budgets
BUDGET_SECONDS_DEFAULT=180
MAX_OPTUNA_TRIALS=20
RANDOM_SEED_DEFAULT=42
STORAGE_PATH=./backend/artifacts
